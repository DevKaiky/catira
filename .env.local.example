# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Usada apenas em rotas server-side que precisem ignorar RLS (ex: jobs de IA).
# Nunca exponha esta chave no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Provedor de IA usado para gerar os relatórios da Fase 3 (src/lib/ai).
# Valores aceitos hoje: gemini (deepseek e kimi ainda não implementados).
AI_PROVIDER=gemini

# Chave específica do provedor selecionado. Gere em https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Alternativa neutra: usada como fallback se a chave específica do provedor não estiver
# definida. Útil para trocar de provedor mudando só AI_PROVIDER.
# AI_API_KEY=

# Sobrescreve o modelo default do provedor selecionado (ex: gemini-3.7-flash).
# AI_MODEL=
